# ============================================================
# Scholaread Self-Hosted (H文献大师) Environment Configuration
# Copy this file to .env and fill in secure values before start.
# ============================================================

# --- Admin Authentication ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=replace-with-a-long-random-hex-string-min-32-chars
JWT_EXPIRE_HOURS=168

# --- PostgreSQL ---
POSTGRES_USER=scholaread
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=scholaread

# --- Aliyun Bailian / OpenAI-Compatible API Defaults ---
# Global default endpoint (Aliyun DashScope OpenAI-compatible mode)
DEFAULT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_API_KEY=sk-your-dashscope-api-key

# Module 1: Vision Layout & Figure Bounding Box Model
DEFAULT_VISION_MODEL=qwen3.5-ocr
# Module 2: Background Full-Paper Translation & Metadata/Partition Extraction
DEFAULT_TRANSLATE_MODEL=deepseek-v4.1-flash-1017
# Module 3: Reader Sidebar AI Companion & Anchor Q&A
DEFAULT_CHAT_MODEL=deepseek-v4.1-flash-1017
DEFAULT_CHAT_THINKING_LEVEL=high

# --- Server Runtime ---
DATA_DIR=/app/data
MAX_UPLOAD_MB=60
PDF_RENDER_DPI=200
BACKEND_INTERNAL_URL=http://backend:8000
